; Engine configuration file.
; Edit through the Godot editor when possible.
config_version=5

[application]

config/name="iT-BATTLE: 值班幸存者"
run/main_scene="res://scenes/bootstrap.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

ProfileStore="*res://scripts/profile_store.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[gui]

theme/custom_font="res://assets/fonts/NotoSansSC-VF.ttf"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.0196, 0.0314, 0.0549, 1)

[debug]

settings/fps/force_fps=0
